# ---------- Server ----------
PORT=5050
JWT_SECRET=change-this-to-a-long-random-string

# ---------- Email to customer / admin / owner (SMTP) ----------
# Gmail: enable 2FA, create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Dac's Car Rental <yourgmail@gmail.com>"

# ---------- WhatsApp (pick ONE provider; leave blank to use click-to-send links) ----------
# Option A: Twilio WhatsApp (sandbox works for testing) https://www.twilio.com/whatsapp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
# Option B: Meta WhatsApp Cloud API https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---------- EmailJS (optional, browser-side instant alert to the business email) ----------
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
